[Unit]
Description=Cloudflare quick tunnel for Wishlist API
After=network.target wishlist-api.service
Wants=wishlist-api.service

[Service]
Type=simple
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate --url http://127.0.0.1:8791
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
